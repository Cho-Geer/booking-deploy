<apex:page standardController="Account">
    <apex:stylesheet value="{! URLFOR($Resource.jQueryMobileForVforce,'jquery.mobile-1.4.5.min.css')}"/>
    <apex:includeScript value="{! URLFOR($Resource.jQueryForVforce)}"></apex:includeScript>
    <apex:includeScript value="{! URLFOR($Resource.jQueryMobileForVforce,'jquery.mobile-1.4.5.min.js')}"></apex:includeScript>
    <script src="/soap/ajax/49.0/connection.js" type="text/javascript"></script>
    <script type="text/javascript">
    	$(document).ready(function(){
        	sforce.connection.sessionId = "{! $Api.Session_ID}";
        	$("[data-id=input]").on("change",function(){
            	var value = this.value;
                var account = new sforce.SObject("Account");
                account.Name = value;
                sforce.connection.create([account],{
                	onSuccess:success,
                    onFailure:failed
                });
                function success(result){
                if(result[0].getBoolean("success") && result[0].id !== undefined){
                	$("[data-id=output]").text(result[0].id);
                }else{
                	$("[data-id=output]").text("作成に失敗した！");
                }
                };
                function failed(error){
                	$("[data-id=output]").text("接続に失敗した"+error);
                }
            })
        }); 
    </script>
    
    <apex:form >
        <apex:outputLabel value="取引先名"></apex:outputLabel>
    	<apex:inputText html-data-id="input" html-placeholder="入力してください"></apex:inputText>
    </apex:form>
    <apex:outputText html-data-id="output" style="font-size:larger;color:red"></apex:outputText>
</apex:page>