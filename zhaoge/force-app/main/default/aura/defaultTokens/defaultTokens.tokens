    <aura:token name="myHeight" value="100%"></aura:token>
    <aura:token name="myWidth" value="100%"></aura:token>
    <aura:token name="myDisplay_flex" value="flex"></aura:token>
    <aura:token name="myDisplay_block" value="block"></aura:token>
    <aura:token name="myBoxSize" value="border-box"></aura:token>
    <aura:token name="myColHeight" value="100%"></aura:token>
    <aura:token name="myColWidth" value="100%"></aura:token>
</aura:tokens>