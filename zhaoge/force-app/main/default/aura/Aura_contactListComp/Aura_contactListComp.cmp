<aura:component controller="ContactDataController">
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"></aura:handler>
    <lightning:notificationsLibrary aura:id="notifLib" />
    <aura:handler name="compEvent" event="c:Fw_auraCompEvent" action="{!c.handleCompEvent}"></aura:handler>
    <aura:registerEvent name="appEvent" type="c:Fw_auraAppEvent"></aura:registerEvent>
    <!-- <aura:registerEvent name="compEvent_msg" type="c:Fw_auraCompEvent"></aura:registerEvent> -->

    <aura:attribute name="contactList" type="Contact[]"></aura:attribute>

    <lightning:card>
        <aura:set attribute="title">
            <lightning:icon iconName="action:add_contact" size="xx-small"></lightning:icon>
            <span class="slds-text-title_bold slds-text-color_success">
                取引先責任者：
            </span>
        </aura:set>
        <aura:set attribute="footer">
            <lightning:button label="一括登録" variant="brand" onclick="{!c.handleClick}"></lightning:button>
        </aura:set>
        <div class="ContactCreateView">
            <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-table_striped">
                <thead>
                    <tr class="slds-line-height_reset">
                        <th scope="col">
                            <div class="slds-truncate" title="番号">番号</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate" title="姓">姓</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate" title="メール送信除外">メール送信除外</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate" title="重要度">重要度</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate"></div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <aura:iteration items="{!v.contactList}" var="con" indexVar="index">
                        <c:Aura_contactCreateComp contactInstance="{!con}" rowIndex="{!index}"></c:Aura_contactCreateComp>
                    </aura:iteration>
                </tbody>
            </table>
        </div>
    </lightning:card>
</aura:component>