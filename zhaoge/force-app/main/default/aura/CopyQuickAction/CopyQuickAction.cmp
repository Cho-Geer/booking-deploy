<aura:component implements="force:lightningQuickActionWithoutHeader,force:hasRecordId">
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"></aura:handler>
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="fields" type="Object"></aura:attribute>
    <aura:attribute name="isCopyed" type="String" default="3"></aura:attribute>
    <!-- <div hidden="true"> -->
    <force:recordData aura:id="form" recordId="{! v.recordId}" targetRecord="{!v.fields}" layoutType="FULL">
    </force:recordData>
    <!-- </div> -->
    <div class="slds-align_absolute-center slds-page-header">
        <aura:if isTrue="{!v.isCopyed == '0'}">
            <h1 class="slds-page-header__title">copy is successful</h1>
            <aura:set attribute="else">
                <aura:if isTrue="{!v.isCopyed == '1'}">
                    <h1 class="slds-page-header__title">copy is failed</h1>
                    <aura:set attribute="else">
                        <h1 class="slds-page-header__title">copy中。。。。。。</h1>
                    </aura:set>
                </aura:if>
            </aura:set>
        </aura:if>
    </div>
</aura:component>