<aura:component>
    <aura:attribute name="contactInstance" type="Contact"></aura:attribute>
    <aura:attribute name="indexRow" type="Integer"></aura:attribute>

    <!-- <aura:handler name="init" value="{!this}" action="{!c.doInit}"></aura:handler> -->
    <aura:registerEvent name="compEvent" type="c:Fw_CompEvent" />

    <tr>
        <td>
            <lightning:formattedNumber value="{!v.indexRow + 1}"></lightning:formattedNumber>
        </td>
        <td>
            <lightning:input variant="label-hidden" type="text" value="{!v.contactInstance.LastName}" required="true"></lightning:input>
        </td>
        <td>
            <lightning:input variant="label-hidden" type="text" value="{!v.contactInstance.FirstName}"></lightning:input>
        </td>
        <td>
            <lightning:input variant="label-hidden" type="email" value="{!v.contactInstance.Email}"></lightning:input>
        </td>
        <td>
            <lightning:input variant="label-hidden" type="tel" value="{!v.contactInstance.Phone}"></lightning:input>
        </td>
        <td>
            <aura:if isTrue="{!v.indexRow == 0}">
                <div class="slds-m-left_medium">
                    <lightning:buttonIcon iconName="utility:add" variant="brand" onclick="{!c.handleAddRow}"></lightning:buttonIcon>
                </div>
                <aura:set attribute="else">
                    <div class="slds-m-left_medium">
                        <lightning:buttonIcon iconName="utility:delete" variant="bare" onclick="{!c.handleDeleteRow}"></lightning:buttonIcon>
                    </div>
                </aura:set>
            </aura:if>
        </td>
    </tr>
</aura:component>