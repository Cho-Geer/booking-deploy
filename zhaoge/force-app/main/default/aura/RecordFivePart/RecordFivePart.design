<design:component>
    <flexipage:template>
        <flexipage:region name="left_top" defaultWidth="large">
            <flexipage:formfactor type="medium" width="small"></flexipage:formfactor>
        </flexipage:region>
        <flexipage:region name="left_bottom_left" defaultWidth="large">
            <flexipage:formfactor type="medium" width="small"></flexipage:formfactor>
        </flexipage:region>
        <flexipage:region name="left_bottom_right" defaultWidth="large">
            <flexipage:formfactor type="medium" width="small"></flexipage:formfactor>
        </flexipage:region>
        <flexipage:region name="right" defaultWidth="large">
            <flexipage:formfactor type="medium" width="small"></flexipage:formfactor>
        </flexipage:region>
    </flexipage:template>
    <design:supportedFormFactors>
        <design:supportedFormFactor type="small"></design:supportedFormFactor>
        <design:supportedFormFactor type="large"></design:supportedFormFactor>
    </design:supportedFormFactors>
</design:component>