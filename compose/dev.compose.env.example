# 部署环境变量 - 开发环境
# 重要: 为了确保可重复部署和可靠回滚，建议使用不可变镜像标签（如 commit-based 标签）
# 而不是可变分支标签（如 dev、main）。镜像工作流会自动生成以下类型的标签：
# - 分支标签: dev, main (可变，不推荐用于生产)
# - 提交标签: dev-abc123, main-def456 (不可变，推荐)
# - 语义版本: v1.0.0 (不可变)
# - latest: main 分支的最新构建 (可变，不推荐)

POSTGRES_PASSWORD=5382

# 可变分支标签（仅用于快速开发和测试）
# BACKEND_IMAGE=docker.io/{{DOCKER_HUB_USER}}/booking-backend:dev
# BACKEND_MIGRATION_IMAGE=docker.io/{{DOCKER_HUB_USER}}/booking-backend-migration:dev
# FRONTEND_IMAGE=docker.io/{{DOCKER_HUB_USER}}/booking-frontend:dev

# 不可变提交标签（推荐用于可靠部署）
BACKEND_IMAGE=docker.io/{{DOCKER_HUB_USER}}/booking-backend:dev-abc123def
BACKEND_MIGRATION_IMAGE=docker.io/{{DOCKER_HUB_USER}}/booking-backend-migration:dev-abc123def
FRONTEND_IMAGE=docker.io/{{DOCKER_HUB_USER}}/booking-frontend:dev-abc123def

# 语义版本标签（用于正式发布）
# BACKEND_IMAGE=docker.io/{{DOCKER_HUB_USER}}/booking-backend:v1.0.0
# BACKEND_MIGRATION_IMAGE=docker.io/{{DOCKER_HUB_USER}}/booking-backend-migration:v1.0.0
# FRONTEND_IMAGE=docker.io/{{DOCKER_HUB_USER}}/booking-frontend:v1.0.0
