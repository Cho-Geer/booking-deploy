NODE_ENV=development
PORT=3001
API_PREFIX=/v1
DATABASE_URL=postgresql://postgres:5382@postgres:5432/booking_system
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=replace-with-a-real-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-with-a-real-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
REDIS_TTL=3600
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
CSRF_ENABLED=true
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
UPLOAD_BASE_URL=/uploads

# --- MAIL(开发环境: 占位值。邮件功能使用时再配置真实 SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- SF 集成 ---
INTEGRATION_TOKEN=replace-with-dev-token
SF_PROJECTION_ENABLED=false
SF_LOGIN_URL=
SF_REST_BASE_URL=
SF_CLIENT_ID=
SF_USERNAME=
SF_PRIVATE_KEY_PATH=

# --- 保留期删除(注意: 代码默认 DRY_RUN=false=实删除。dev では安全側 true に上書き) ---
RETENTION_ENABLED=true
RETENTION_DRY_RUN=true
RETENTION_DAYS=30