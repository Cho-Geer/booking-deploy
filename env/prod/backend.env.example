NODE_ENV=production
PORT=3001
API_PREFIX=/v1
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/booking_system
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=booking_system
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=replace-with-a-real-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-with-a-real-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
REDIS_TTL=3600
FRONTEND_URL=https://booking.example.com
FRONTEND_URLS=https://booking.example.com
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
CSRF_ENABLED=true
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
UPLOAD_BASE_URL=/uploads
LOG_LEVEL=info
LOG_FILE=logs/app.log
HEALTHCHECK_TIMEOUT_MS=5000
